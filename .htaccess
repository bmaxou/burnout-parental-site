# burnout-parental.fr : une seule adresse par page (actif seulement pour burnout-parental.fr)
# Les catalogues de recherche sont du texte : limiter leur transfert sur mobile.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/javascript text/javascript text/css text/html
</IfModule>

RewriteEngine On
RewriteBase /

# 1. www -> sans www
RewriteCond %{HTTP_HOST} ^www\.burnout-parental\.fr$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^\s?]*)
RewriteRule ^ https://burnout-parental.fr%1 [R=301,L,NE]

# 2. http -> https
RewriteCond %{HTTP_HOST} ^burnout-parental\.fr$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^\s?]*)
RewriteRule ^ https://burnout-parental.fr%1 [R=301,L,NE]

# 3. /index.html -> /
RewriteCond %{HTTP_HOST} ^burnout-parental\.fr$ [NC]
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ https://burnout-parental.fr/ [R=301,L]
